{
  "compilerOptions": {
    "target": "es2020",
    "baseUrl": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "outDir": "easyar-dist"
  },
  "include": [
    "src/ar-easyar",
    "src/ar-shared",
    "config/ar/types/**/*"
  ]
}
